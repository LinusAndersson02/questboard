  "query": "\n            INSERT INTO quest_completions (quest_id, period_start, period_end, xp_reward, coin_reward)\n            VALUES ($1, $2, $3, $4, $5)\n            ON CONFLICT (quest_id, period_start, period_end)\n            DO UPDATE SET completed_at = now()\n            RETURNING\n                id,\n                quest_id,\n                period_start,\n                xp_reward,\n                coin_reward,\n                period_end,\n                completed_at\n            ",
