  "query": "\n        SELECT\n            id,\n            user_id,\n            title,\n            description,\n            kind as \"kind: _\",\n            repeat_unit as \"repeat_unit: _\",\n            repeat_interval,\n            anchor_date,\n            start_date,\n            end_date,\n            start_at,\n            due_at,\n            due_time,\n            timezone,\n            is_active,\n            created_at,\n            updated_at\n        FROM quests\n        WHERE user_id = $1\n        ORDER BY created_at DESC\n        ",
